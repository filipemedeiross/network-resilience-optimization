SOLVER_CLAIM_TTL_SECONDS=600
INSTANCE_GENERATION_MAX_ATTEMPTS=20
SOLVER_MAX_NODES=500
SOLVER_MAX_EDGES=5000
SOLVER_MAX_TIME_SECONDS=60
SOLVER_MAX_CONCURRENCY=1
LOG_LEVEL=INFO
